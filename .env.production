# Safe production defaults committed for `vite build`.
# Host dashboard / CI may override. Never put secrets in this file.
# See docs/deployment.md.
#
# VITE_MAP_SOURCE=remote: without an activated playa pack, show Esri satellite
# online fallback (CORS CDN URLs). Switch to `packaged` once event packs ship
# real offline MapLibre/PMTiles basemaps.

VITE_APP_ENV=production
VITE_DATA_PROVIDER=sample
VITE_MAP_SOURCE=remote
VITE_ENABLE_PROTOTYPE_CONTROLS=false
VITE_ENABLE_BLUETOOTH_EXPERIMENT=false
