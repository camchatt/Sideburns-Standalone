VITE_APP_ENV=development
VITE_DATA_PROVIDER=sample
# remote = Esri CDN online fallback when no pack; sample = brown offline style;
# packaged = prefer installed pack map, else sample (set remote on hosts until packs have PMTiles).
VITE_MAP_SOURCE=remote
VITE_ENABLE_PROTOTYPE_CONTROLS=true
VITE_ENABLE_BLUETOOTH_EXPERIMENT=false

# Modes (see docs/deployment.md):
# - sample / local: VITE_DATA_PROVIDER=sample (default) — no credentials
# - preview / local CLI sync: VITE_DATA_PROVIDER=supabase + loopback URL allowed when not production
# - production: VITE_APP_ENV=production, prototype controls off;
#   supabase mode requires https SIDEBURNS URL + anon/publishable key (build fails otherwise)

# Optional. Required only when VITE_DATA_PROVIDER=supabase.
# Use the SIDEBURNS project only — never Artelier credentials.
# Dashboard: https://supabase.com/dashboard/project/mxqrchnkjxgmdvswbptz
# Publishable/anon key only. Never put a service-role key in any VITE_* variable.
VITE_SUPABASE_URL=https://mxqrchnkjxgmdvswbptz.supabase.co
VITE_SUPABASE_ANON_KEY=
# Legacy alias also accepted by env validation:
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend design: docs/supabase-backend.md (local migrations under supabase/).
# Deployment / HTTPS / SPA host: docs/deployment.md
# Do not set VITE_SUPABASE_SERVICE_ROLE_KEY — env validation rejects it.
# Do not deploy until explicitly authorized.
