{
  "name": "sidequester",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8090 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 8090",
